# LLM provider: mock (default, no deps) | claude-cli (dev-only, uses your
# authenticated Claude Code CLI, quickest model) | gemini (later — needs key)
LLM_PROVIDER=mock
# GEMINI_API_KEY=...
# LLM_MOCK_CHAOS=0   # disable simulated provider failures (demo mode)

# Voice engines (all optional — system + Kokoro work with nothing set):
# CHATTERBOX_URL=http://127.0.0.1:8004   # local Chatterbox-TTS-Server (studio voice + cloning, offline)
# CHATTERBOX_VOICE=Emily.wav             # a file in the server's voices/ or reference_audio/
# ELEVENLABS_API_KEY=...                 # cloud engine (free signup tier)
# ELEVENLABS_VOICE_ID=...

# Platform layer (ALL optional — with nothing set the app runs fully in
# guest/localStorage mode; each feature activates only when its env exists):

# Server persistence (Mongo/Atlas). Unset → /api/sessions answers 501 and
# history stays in localStorage. Also where user accounts live: with MONGODB_URI
# set, registered users persist in the 'users' collection; unset, they persist
# in a local .data/users.json file (zero-setup demo — Mongo is the prod path).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/pds
# MONGODB_DB=pds                         # optional — defaults to the db named in the URI path

# Email + password sign-in (the primary Login module) works out of the box with
# NO env — accounts save to .data/users.json and sessions are signed with a
# built-in DEV secret. In production you MUST set your own secret below, or every
# session token is forgeable (the dev fallback is public in the source).
# AUTH_JWT_SECRET=...                    # any long random string (e.g. `openssl rand -hex 32`)

# Google sign-in (next-auth v5) — OPTIONAL secondary provider. All three required
# to activate; unset → email+password / guest mode only.
# AUTH_SECRET=...                        # `npx auth secret` or any long random string
# AUTH_GOOGLE_ID=...                     # Google OAuth client id
# AUTH_GOOGLE_SECRET=...                 # Google OAuth client secret
# AUTH_URL=https://your-deploy.example   # only needed if next-auth can't infer the deploy URL

# Rate limiting (Upstash Redis REST). Unset → in-memory per-instance buckets
# (fine locally; REQUIRED on Vercel — serverless instances don't share memory).
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Groq — production LLM brain (sub-second turns). When set, the interviewer,
# scoring, resume analysis, guidance, and GD debate all use it.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile   # or llama-3.1-8b-instant (fastest)
